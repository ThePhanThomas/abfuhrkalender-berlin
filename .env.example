# Kopieren nach .env und ausfüllen. Die .env-Datei NIE committen.

# Zugangsdaten Kundenportal Berlin Recycling (nur nötig für Papier im Modus "Kundenportal")
# Für Docker (Synology): jedes $ doppelt schreiben ($$), sonst wird das
# Passwort abgeschnitten. Keine Anführungszeichen.
BR_USERNAME=
BR_PASSWORD=

# Wie oft automatisch abgerufen wird (Stunden). 0 = nur per Button.
REFRESH_INTERVAL_HOURS=168

# Benutzer- und Gruppennummer, unter der die App im Container läuft.
# Muss zum Besitzer des Ordners data/ passen. Auf der Synology per SSH mit
# dem Befehl `id` herausfinden (oft uid=1026, gid=100).
PUID=1000
PGID=1000
